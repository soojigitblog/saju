# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never expose to the browser / Client Components
SUPABASE_SECRET_KEY=

# AI Provider: gemini | openai | mock
# Dev default recommendation: gemini (with GEMINI_API_KEY) or mock
AI_PROVIDER=gemini

# Gemini (server-only — never NEXT_PUBLIC_*)
GEMINI_API_KEY=
GEMINI_MODEL_FREE=gemini-3.6-flash
GEMINI_MODEL_PAID=gemini-3.6-flash

# OpenAI (server-only — optional; preserved for paid / A-B)
OPENAI_API_KEY=
AI_MODEL_FREE=gpt-5.6-luna
AI_MODEL_PAID=gpt-5.6-terra

# Do NOT set automatic paid fallback (empty = disabled)
AI_FALLBACK_PROVIDER=

AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# Free fortune rate limit
FREE_FORTUNE_LIMIT=5
FREE_FORTUNE_WINDOW_SECONDS=3600

# -----------------------------------------------------------------------------
# Legacy note (not used by this project):
# Older Supabase docs used NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY.
# New projects should use publishable + secret keys above.
# -----------------------------------------------------------------------------
