# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never expose to the browser / Client Components
SUPABASE_SECRET_KEY=

# AI Provider: gemini | openai | mock
# Dev default recommendation: gemini (with GEMINI_API_KEY) or mock
# `next start` sets NODE_ENV=production — keep APP_ENV=development (below) so
# mock AI remains allowed for local/tunnel friend tests. Real deploys: gemini|openai.
AI_PROVIDER=gemini
# ALLOW_MOCK_AI=1

# Gemini (server-only — never NEXT_PUBLIC_*)
GEMINI_API_KEY=
GEMINI_MODEL_FREE=gemini-3.6-flash
GEMINI_MODEL_PAID=gemini-3.6-flash

# OpenAI (server-only — optional; preserved for paid / A-B)
OPENAI_API_KEY=
AI_MODEL_FREE=gpt-5.6-luna
AI_MODEL_PAID=gpt-5.6-terra

# Do NOT set automatic paid fallback (empty = disabled)
AI_FALLBACK_PROVIDER=

AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# Free fortune rate limit
FREE_FORTUNE_LIMIT=5
FREE_FORTUNE_WINDOW_SECONDS=3600

# Free tarot (saju × tarot) rate limit — friend-test default: 1 / day
FREE_TAROT_LIMIT=1
FREE_TAROT_WINDOW_SECONDS=86400

# Paid report quality preview — OWNER/QA ONLY (not shown in public UI).
# Requires ALLOW_PAID_PREVIEW=1. Direct URL: /report/preview/{freeResultId}
ALLOW_PAID_PREVIEW=

# Toss Payments TEST (optional — bank transfer is default checkout)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
PAYMENT_PROVIDER=
APP_ENV=development

# -----------------------------------------------------------------------------
# Bank transfer (PHASE 6.2+) — default checkout
# Account shown to users via server DTO only (never hardcode in Client JS)
# -----------------------------------------------------------------------------
BANK_TRANSFER_BANK_NAME=하나은행
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_HOLDER=
BANK_TRANSFER_ORDER_TTL_HOURS=24

# Bank poller: mock | hana
BANK_PROVIDER=hana
BANK_POLL_INTERVAL_SECONDS=120
BANK_POLL_INTERVAL_MS=120000

# Hana Playwright automation (PHASE 6.4)
# 1) npm run bank:hana:login — user completes normal bank auth once
# 2) npm run bank:poll — uses saved session (no password in env)
HANA_BANK_AUTOMATION_ENABLED=
HANA_BANK_SESSION_DIR=.playwright-hana
# Optional: DOM inquiry button selector after landing on saved tx URL
# HANA_BANK_INQUIRY_SUBMIT_SELECTOR=button:has-text("조회")
# Test fixture JSON (vitest only — not for production)
# HANA_BANK_FIXTURE_JSON=

# Admin manual bank match (fallback when auto poll fails)
ADMIN_MANUAL_TOKEN=

# -----------------------------------------------------------------------------
# Legacy note (not used by this project):
# Older Supabase docs used NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY.
# New projects should use publishable + secret keys above.
# -----------------------------------------------------------------------------
