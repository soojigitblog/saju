# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never expose to the browser / Client Components
SUPABASE_SECRET_KEY=

# AI Provider: gemini | openai | mock
# Dev default recommendation: gemini (with GEMINI_API_KEY) or mock
# `next start` sets NODE_ENV=production — keep APP_ENV=development (below) so
# mock AI remains allowed for local/tunnel friend tests. Real deploys: gemini|openai.
AI_PROVIDER=gemini
# Separate billing policy (falls back to AI_PROVIDER when unset)
AI_PROVIDER_FREE=gemini
AI_PROVIDER_PAID=gemini
# ALLOW_MOCK_AI=1

# Gemini (server-only — never NEXT_PUBLIC_*)
# FREE: GEMINI_API_KEY_FREE (falls back to GEMINI_API_KEY for free fortune/tarot only)
# PAID: GEMINI_API_KEY_PAID — required only when activating paid Gemini Live
# (first real paid customer or explicit approval). Pre-launch: leave empty (DEFERRED).
GEMINI_API_KEY=
GEMINI_API_KEY_FREE=
# GEMINI_API_KEY_PAID=
GEMINI_MODEL_FREE=gemini-3.6-flash
GEMINI_MODEL_PAID=gemini-3.6-flash

# OpenAI (server-only — optional; preserved for paid / A-B)
OPENAI_API_KEY=
# OPENAI_API_KEY_FREE=
# OPENAI_API_KEY_PAID=
AI_MODEL_FREE=gpt-5.6-luna
AI_MODEL_PAID=gpt-5.6-terra

# Do NOT set automatic paid fallback (empty = disabled)
AI_FALLBACK_PROVIDER=

AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
# Paid report output token cap (cost guard)
PAID_REPORT_MAX_OUTPUT_TOKENS=8192
# Optional pricing overrides (USD per 1M tokens)
# GEMINI_PRICE_INPUT_PER_1M=0.1
# GEMINI_PRICE_OUTPUT_PER_1M=0.4
# USD_TO_KRW_RATE=1400

# Free fortune rate limit
FREE_FORTUNE_LIMIT=5
FREE_FORTUNE_WINDOW_SECONDS=3600

# Free tarot (saju × tarot) rate limit — friend-test default: 1 / day
FREE_TAROT_LIMIT=1
FREE_TAROT_WINDOW_SECONDS=86400

# Paid report quality preview — OWNER/QA ONLY (not shown in public UI).
# Requires ALLOW_PAID_PREVIEW=1. Direct URL: /report/preview/{freeResultId}
ALLOW_PAID_PREVIEW=

# P7 production gate — set on deployment host (not .env.local-only)
# PRODUCTION_ORIGIN=https://your-production-domain.com
# Checkout ON + Generation OFF = accept payment, zero Paid Gemini cost until key + approval.
PAID_CHECKOUT_ENABLED=false
PAID_REPORT_GENERATION_ENABLED=false
# Legacy: when set, enables BOTH checkout and generation (prefer explicit flags above).
PAID_REPORT_LIVE_ENABLED=false
# QA-only: allow internal test orders while live is off (test runner + explicit flag only)
# ALLOW_PAID_QA_CHECKOUT=1
# Never exposed to customer HTTP — internalQaCheckout is server-gated in createOrderForGuest

# Toss Payments — 기본 체크아웃 (TEST 키로 로컬 샌드박스 결제)
# 하나은행 입금확인은 사용하지 않음. 운영 전환 시에만 live_ 키 + APP_ENV=production.
ALLOW_TOSS_CHECKOUT=0
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
PAYMENT_PROVIDER=toss
APP_ENV=development
# In the Toss Payments dashboard, register:
# https://YOUR_DOMAIN/api/payments/toss/webhook (PAYMENT_STATUS_CHANGED)

# -----------------------------------------------------------------------------
# Bank transfer (PHASE 6.2+) — default checkout
# Account shown to users via server DTO only (never hardcode in Client JS)
# -----------------------------------------------------------------------------
BANK_TRANSFER_BANK_NAME=하나은행
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_HOLDER=
BANK_TRANSFER_ORDER_TTL_HOURS=24

# Bank poller: mock | hana
BANK_PROVIDER=hana
BANK_POLL_INTERVAL_SECONDS=120
BANK_POLL_INTERVAL_MS=120000

# Hana Playwright automation (PHASE 6.4 / 6.4.1)
# Credentials: Windows Credential Manager via `npm run bank:hana:credentials`
#   (never put bank password in .env / DB / source)
# Worker: npm run bank:hana:start
HANA_BANK_AUTOMATION_ENABLED=
HANA_AUTO_LOGIN_ENABLED=1
HANA_AUTO_LOGIN_MAX_FAILURES=3
HANA_BANK_SESSION_DIR=.playwright-hana
# HANA_BANK_HEADLESS=0  # show browser while debugging login
# Optional: DOM inquiry button selector after landing on saved tx URL
# HANA_BANK_INQUIRY_SUBMIT_SELECTOR=button:has-text("조회")
# Test fixture JSON (vitest only — not for production)
# HANA_BANK_FIXTURE_JSON=

# Admin: Supabase Auth + user_roles.role=ADMIN (see npm run admin:grant)
# Deprecated for production UI — test-only fallback for /api/admin/* :
# ADMIN_MANUAL_TOKEN=
# ADMIN_MANUAL_BYPASS=1  # mock mode tests only

# Telegram admin alerts (server-only — never NEXT_PUBLIC_*)
# Used when user taps 「입금했어요」; also reusable for AMBIGUOUS bank matches
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# -----------------------------------------------------------------------------
# Legacy note (not used by this project):
# Older Supabase docs used NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY.
# New projects should use publishable + secret keys above.
# -----------------------------------------------------------------------------
